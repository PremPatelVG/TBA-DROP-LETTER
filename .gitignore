# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify (local CLI state)
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts
preview/dist/
preview/dist-demo/

# firebase
.firebase/
firebase-debug.log*
firebase-debug.*.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
database-debug.log
.runtimeconfig.json
/functions/lib/
/functions/node_modules/
/.next-e2e/
/tests/e2e/output/

# secrets: service account keys must never be committed
service-account*.json
*-firebase-adminsdk-*.json

# Android app (npm run build:apk): generated project, built files, and signing keys (never commit a key)
/android/build/
/android/output/
*.keystore
*.jks
