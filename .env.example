# Copy to .env.local for local development. Never commit .env.local or any service account key.

# ---- Mode -------------------------------------------------------------------------------------
# true (default): in-browser demo data, no Firebase needed. false: Firebase (Google sign-in + Firestore).
NEXT_PUBLIC_USE_MOCK=true

# ---- Firebase web app (Firebase console > Project settings > General > Your apps > Web app) -----
# These are public identifiers, not secrets. On Firebase App Hosting they are filled in automatically.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Local: <project-id>.firebaseapp.com. Production: the app's own domain, so redirect sign-in works on
# phones (see README, go-live step 9).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# ---- Server (Admin SDK, used by the server actions in src/app/actions.ts) -----------------------
# Firebase App Hosting / Cloud Run: leave empty (the server's own service account is used).
# Other hosts (Vercel, a VPS...): the service account key JSON on one line, or base64 of it. SECRET.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional; defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Optional; where /__/auth/* is forwarded for redirect sign-in. Defaults to https://<project-id>.firebaseapp.com
FIREBASE_AUTH_HELPER_ORIGIN=

# ---- Local emulators (npm run emulators; see README, "Local development with the emulators") -----
# Browser side:
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Server side (Admin SDK picks these up automatically when set):
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# ---- Android app for advisors (README, "Android app for advisors") ------------------------------
# Served at /.well-known/assetlinks.json so the app opens without the browser bar. Not secrets.
# Package name (default com.tba.dropletter); must match android/twa-manifest.json.
ANDROID_PACKAGE_NAME=
# SHA-256 fingerprint of the app signing key (npm run build:apk prints it). With Google Play app signing,
# add Play's fingerprint too, after a comma.
ANDROID_CERT_SHA256=

# ---- Build ------------------------------------------------------------------------------------
# Optional; build output folder (the emulator end-to-end test uses .next-e2e).
NEXT_DIST_DIR=
