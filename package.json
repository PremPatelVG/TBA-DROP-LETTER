{
  "name": "tba-drop-letter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview:build": "vite build --config preview/vite.config.ts && node preview/finalize.mjs",
    "build:demo": "vite build --config preview/vite.config.ts --mode demo && node preview/finalize.mjs demo",
    "build:apk": "node scripts/build-apk.mjs",
    "functions:build": "npm --prefix functions run build",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-tba --only auth,firestore,functions,pubsub",
    "emulators:seed": "node --no-warnings scripts/seed-emulators.mjs",
    "create-master": "node --no-deprecation scripts/create-master.mjs",
    "test": "npm run test:unit && npm run test:rules && npm run test:functions",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-tba --only firestore \"node --test 'tests/rules/*.test.mjs'\"",
    "test:functions": "npm run functions:build && firebase emulators:exec --project demo-tba --only firestore \"node --test 'functions/lib/**/*.test.js'\"",
    "test:e2e": "npm run functions:build && firebase emulators:exec --project demo-tba --only auth,firestore,functions,pubsub \"node tests/e2e/run.mjs\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.25.0",
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "firebase-tools": "^15.32.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
